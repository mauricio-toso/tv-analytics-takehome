{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableAutoMode": "disable",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm why *)",
      "Bash(pnpm audit)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)"
    ],
    "ask": ["Edit(./package.json)", "Edit(./pnpm-lock.yaml)", "Edit(./.npmrc)"],
    "deny": [
      "Bash(git commit *)",
      "Bash(pnpm install)",
      "Bash(pnpm install --force*)",
      "Bash(pnpm install --no-frozen-lockfile*)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm approve-builds *)",
      "Bash(docker compose up)",
      "Bash(docker compose up *)",
      "Bash(docker compose down)",
      "Bash(docker compose down *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm publish *)",
      "Bash(pnpm version *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f *)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker compose down -v *)",
      "Bash(docker volume rm *)",
      "Edit(./seed/**)",
      "Write(./seed/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
